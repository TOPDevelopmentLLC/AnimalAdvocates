# Copy to .env.local for local development. Never commit real values.

# Secret ShelterLuv API key. NO VITE_ PREFIX — this must stay server-side
# (used only by the Vite dev proxy in vite.config.ts and by the production
# Lambda proxy's own environment variables). Never rename this with a
# VITE_ prefix; Vite would inline it into the public client bundle.
SHELTER_LUV_API_KEY=

# Public URL of the production ShelterLuv proxy Lambda Function URL.
# Safe to expose (VITE_ prefix is fine here — it's just an endpoint address,
# not a secret). Leave unset in local dev so the app falls back to the Vite
# dev proxy instead.
VITE_SHELTERLUV_PROXY_URL=
